# Use absolute Linux/WSL paths. Lists are separated with semicolons.
OPENCODE_QUARANTINE_ALLOWED_ROOTS=/absolute/path/to/workspace
OPENCODE_AUTO_VERIFY_WRITABLE_ROOTS=/absolute/path/to/workspace;/tmp/opencode
OPENCODE_PROTECTED_PATHS=/absolute/path/to/workspace;/absolute/path/to/quarantine
OPENCODE_QUARANTINE_ROOT=/absolute/path/to/quarantine

# OpenAI-compatible reviewer endpoint and model.
OPENCODE_AUTO_VERIFY_BASE_URL=http://127.0.0.1:8030/v1
OPENCODE_AUTO_VERIFY_MODEL=your-reviewer-model-id
OPENCODE_AUTO_VERIFY_PROVIDER=llama_router

# Prefer a private key file or shell secret store. Never commit a real key.
# LLAMA_ROUTER_API_KEY=
# LLAMA_ROUTER_KEY_FILE=/absolute/private/path/router-api-key.txt

# The general reviewer reconstructs scope; the quarantine reviewer checks one
# already-resolved preview token and can normally use a lighter effort.
OPENCODE_AUTO_VERIFY_REASONING_EFFORT=xhigh
OPENCODE_AUTO_VERIFY_MAX_TOKENS=8192
OPENCODE_QUARANTINE_REVIEW_REASONING_EFFORT=low
OPENCODE_QUARANTINE_REVIEW_MAX_TOKENS=2048
OPENCODE_AUTO_VERIFY_TIMEOUT_MS=180000
OPENCODE_QUARANTINE_PREVIEW_TTL_MS=600000
OPENCODE_QUARANTINE_SCAN_LIMIT=20000
